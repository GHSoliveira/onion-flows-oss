# SEGURANCA
JWT_SECRET=<your_strong_jwt_secret>
JWT_EXPIRES_IN=8h
ADMIN_INITIAL_PASSWORD=<define_a_strong_admin_password_for_seed>
# Gere uma chave aleatoria de 32 bytes em base64; nao reutilize JWT_SECRET.
# Formato para rotacao: v1:<base64-32B>,v2:<base64-32B>
DATA_ENCRYPTION_KEYS=
ACTIVE_DATA_KEY=

# CONFIGURACAO
NODE_ENV=production
PORT=3001
CLIENT_URL=https://painel.example.com

# BANCO DE DADOS
# postgres (recomendado), json (local e testes; veja .env.sandbox.example),
# mongo e supabase (legados).
DB_ADAPTER=postgres

# MongoDB (legado, so com DB_ADAPTER=mongo)
MONGODB_URI=<your_mongodb_connection_string>
MONGODB_DB_NAME=onionflow

# Supabase REST (legado, so com DB_ADAPTER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your_supabase_service_role_key>
SUPABASE_SECRET_KEY=<your_supabase_secret_key>
SUPABASE_ANON_KEY=<optional_fallback_only>
SUPABASE_DOCUMENTS_TABLE=app_documents

# POSTGRESQL (DB_ADAPTER=postgres, USE_JSON_DB=false)
# Os documentos ficam numa tabela unica; crie com scripts/supabase-bootstrap.sql.
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=<your_database_password>
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=true
PGSSL_CA_PATH=/etc/onion-flows/supabase-ca.crt
PGPOOL_MAX=5
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
POSTGRES_DOCUMENTS_TABLE=app_documents

# LOGS
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
HEARTBEAT_LAST_SEEN_MIN_MS=60000
DB_CHANGE_LOGGER_ENABLED=false

# WEBSOCKETS
SOCKET_CORS_ORIGIN=https://painel.example.com

# WHATSAPP CLOUD API
WHATSAPP_GRAPH_VERSION=v21.0
META_CATALOG_GRAPH_VERSION=v24.0
META_CATALOG_TIMEOUT_MS=20000

# Credenciais do app Meta da propria Onion. Com Embedded Signup existe um app so,
# e nao um por cliente: estes valores passam a ser a fonte primaria da verificacao
# de webhook, e o que estiver gravado por tenant vira legado.
WHATSAPP_APP_ID=<id_do_app_meta>
WHATSAPP_APP_SECRET=<segredo_do_app_meta>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<token_de_verificacao_do_webhook>
# config_id da Login Configuration criada no App Dashboard (Embedded Signup v4)
WHATSAPP_ES_CONFIG_ID=<config_id_do_embedded_signup>

# Enquanto houver tenant com appSecret proprio, deixe true: o webhook continua
# aceitando os segredos antigos como fallback. Desligue quando todos migrarem.
WHATSAPP_LEGACY_PER_TENANT_SECRET=true

# REDIS E FILAS
REDIS_ENABLED=false
BULLMQ_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
WHATSAPP_QUEUE_CONCURRENCY=5
WEBHOOK_QUEUE_CONCURRENCY=5
CAMPAIGN_QUEUE_CONCURRENCY=2
AI_CLASSIFICATION_QUEUE_CONCURRENCY=3
CADENCE_QUEUE_CONCURRENCY=2
TURIZMO_QUEUE_CONCURRENCY=3
METRICS_QUEUE_CONCURRENCY=2

# CLASSIFICACAO COM IA
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_API_KEY=<your_ai_api_key>
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_CLASSIFICATION_ENABLED=false
OUTREACH_METRICS_V2_ENABLED=true
CLIENT_CAMPAIGN_ACCESS_ENABLED=false
AI_CLASSIFICATION_TIMEOUT_MS=10000
AI_TOTAL_TIMEOUT_MS=20000
AI_CLASSIFICATION_MAX_ATTEMPTS=5
AI_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.8
AI_CLASSIFICATION_REVIEW_THRESHOLD=0.6
AI_REASONING_ENABLED=true
AI_REASONING_CONFIDENCE_THRESHOLD=0.78
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_MS=60000
AI_STRUCTURED_OUTPUTS_ENABLED=true

# FALLBACKS DE IA (opcionais; roteamento rapido -> raciocinio -> contingencia)
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
GEMINI_TIMEOUT_MS=10000
GEMINI_STRUCTURED_OUTPUTS_ENABLED=true
GROQ_API_KEY=<your_groq_api_key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.6-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_MS=10000
GROQ_STRUCTURED_OUTPUTS_ENABLED=true

# Workers AI: fallback independente opcional
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_TIMEOUT_MS=8000

# OpenRouter gratuito: use apenas como ultima contingencia (limites baixos)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_MS=8000
OPENROUTER_SITE_URL=http://localhost:5173

# INTEGRACAO TURIZMO
TURIZMO_BASE_URL=http://localhost:4545
TURIZMO_API_KEY=<your_turizmo_outbound_api_key>
TURIZMO_INBOUND_API_KEY=<generate_a_long_random_secret>
TURIZMO_INBOUND_ENABLED=true
TURIZMO_INTEGRATION_ENABLED=true
TURIZMO_EVENT_TIMEOUT_MS=10000
TURIZMO_EVENT_MAX_ATTEMPTS=8
TURIZMO_CIRCUIT_FAILURE_THRESHOLD=5
TURIZMO_CIRCUIT_RESET_MS=30000

# CADENCIAS E LIMITES DE OUTREACH
CADENCE_ENGINE_ENABLED=false
CADENCE_WORKER_INTERVAL_MS=15000
CADENCE_LOCK_TIMEOUT_MS=300000
OUTREACH_CAMPAIGN_MAX_CONTACTS=250
OUTREACH_MAX_PER_MINUTE=30
OUTREACH_MAX_PER_HOUR=500
OUTREACH_MAX_PER_DAY=5000
OUTREACH_SEND_JITTER_MIN_MS=250
OUTREACH_SEND_JITTER_MAX_MS=1500



# Dominio dos enderecos proprios de agencia (agencia.<dominio>).
AGENCY_ROOT_DOMAIN=example.com
