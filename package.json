{
  "name": "onion-flows",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:commercial": "node --test tests/commercialDomain.test.js",
    "test:engine": "node --test tests/*.test.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate:supabase": "node scripts/migrate-to-supabase.mjs",
    "migrate:postgres": "node scripts/migrate-json-to-postgres.mjs",
    "smoke:postgres": "node scripts/postgres-smoke.mjs",
    "security:install-hooks": "node scripts/install-git-hooks.mjs",
    "security:scan": "gitleaks git --redact --no-banner",
    "seed:admin": "node scripts/seed-admin.js",
    "migrate:outreach": "node scripts/migrate-outreach-ecosystem.js",
    "sandbox:seed": "node --env-file=.env.sandbox scripts/seed-sandbox-json.js",
    "sandbox": "npm run sandbox:seed && node --env-file=.env.sandbox index.js"
  },
  "keywords": [],
  "author": "Gustavo Oliveira",
  "license": "MIT",
  "description": "Plataforma de atendimento por WhatsApp com editor visual de fluxos, filas de atendimento humano e marca branca para agencias.",
  "dependencies": {
    "@sentry/core": "^10.75.0",
    "acorn": "^8.16.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.10",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.8.0",
    "nodemon": "^3.1.11",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "puppeteer": "^25.10.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}
