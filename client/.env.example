# URL da API. Em producao aponta para o backend atras do tunel Cloudflare.
VITE_API_URL=http://localhost:3001

# WhatsApp Embedded Signup (Fase 0 na Meta gera estes dois valores).
# Enquanto estiverem vazios o botao de conexao nao aparece e o fluxo manual
# do MetaSetup continua sendo o unico caminho.
VITE_WHATSAPP_APP_ID=
VITE_WHATSAPP_ES_CONFIG_ID=
VITE_WHATSAPP_GRAPH_VERSION=v25.0

# Dados desta instalacao (contato de suporte e paginas legais).
VITE_SUPPORT_EMAIL=suporte@example.com
VITE_SUPPORT_WHATSAPP=
VITE_LEGAL_COMPANY_NAME=Sua Empresa Ltda
VITE_LEGAL_CNPJ=00.000.000/0000-00
# Dominio dos enderecos de agencia (agencia.<dominio>). Igual ao AGENCY_ROOT_DOMAIN da API.
VITE_ROOT_DOMAIN=example.com
