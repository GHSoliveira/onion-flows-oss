# Ambiente local com banco JSON: nao precisa de Postgres, Redis nem conta na Meta.
# Copie para .env.sandbox e rode `npm run sandbox`.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

DB_ADAPTER=json
USE_JSON_DB=true
JSON_DB_PATH=./sandbox/data/db.json
DB_AUTO_INDEX=false

CHAT_STATE_REPAIR_ON_BOOT=false
CHAT_RUNTIME_WATCHER_ENABLED=false
DB_CHANGE_LOGGER_ENABLED=false
OUTREACH_CAMPAIGN_WORKER_ENABLED=false
TELEGRAM_USE_POLLING=false
SUPER_ADMIN_IP_WHITELIST_DISABLED=true

# Mensagens de WhatsApp nao saem de verdade; ficam registradas localmente.
WHATSAPP_FAKE_SEND=true
WHATSAPP_WEBHOOK_VERIFY_TOKEN=sandbox-verify-token
WHATSAPP_FAKE_MEDIA_DIR=./sandbox/fake-whatsapp-media

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_MAX=50
HEARTBEAT_LAST_SEEN_MIN_MS=60000

# Usuarios criados pelo seed local.
SANDBOX_ADMIN_USERNAME=admin
SANDBOX_ADMIN_PASSWORD=sandbox123
SANDBOX_AGENT_USERNAME=agent
SANDBOX_AGENT_PASSWORD=sandbox123
